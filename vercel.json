{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/:path*"
    }
  ],
  "functions": {
    "api/scans.ts": {
      "maxDuration": 45
    },
    "api/cron/cleanup.ts": {
      "maxDuration": 30
    },
    "api/reports/[id].ts": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 4 * * *"
    }
  ]
}
