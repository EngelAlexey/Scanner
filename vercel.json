{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/v1/:path*", "destination": "/api/:path*" }],
  "functions": {
    "api/scans.ts": { "maxDuration": 30 },
    "api/cron/cleanup.ts": { "maxDuration": 30 }
  },
  "crons": [{ "path": "/api/cron/cleanup", "schedule": "0 4 * * *" }]
}
